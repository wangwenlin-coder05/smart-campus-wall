<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wwl.mapper.WallCategoryMapper">

    <!-- 基础字段片段 -->
    <sql id="base_column">
        id,name,sort,is_show,is_deleted,create_time,update_time
    </sql>

    <!-- 动态条件查询一级分类 -->
    <select id="selectCategoryList" resultType="com.wwl.model.entity.WallCategory">
        SELECT <include refid="base_column"/>
        FROM wall_category
        <where>
            <!-- 软删除过滤 -->
            is_deleted = 0
            <!-- 名称模糊查询 -->
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%',#{name},'%')
            </if>
            <!-- 是否前台展示 -->
            <if test="isShow != null">
                AND is_show = #{isShow}
            </if>
        </where>
        ORDER BY sort ASC
    </select>

    <!-- 根据ID查询单个分类 -->
    <select id="selectCategoryById" resultType="com.wwl.model.entity.WallCategory">
        SELECT <include refid="base_column"/>
        FROM wall_category
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <!-- 新增一级分类 -->
    <insert id="insertCategory">
        INSERT INTO wall_category
        (name,sort,is_show,is_deleted,create_time,update_time)
        VALUES
            (#{name},#{sort},#{isShow},#{isDeleted},#{createTime},#{updateTime})
    </insert>

    <!-- 修改一级分类 动态SQL 只更新非空字段 -->
    <update id="updateCategory">
        UPDATE wall_category
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="isShow != null">is_show = #{isShow},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id} AND is_deleted = 0
    </update>

    <!-- 逻辑删除 -->
    <update id="logicDeleteCategory">
        UPDATE wall_category SET is_deleted = 1 WHERE id = #{id}
    </update>

</mapper>