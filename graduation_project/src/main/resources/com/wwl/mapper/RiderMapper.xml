<?xml version="1.0" encoding="UTF-8"?>
        <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
                "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

        <!-- 绑定对应mapper接口全路径 -->
<mapper namespace="com.wwl.mapper.RiderMapper">

    <!-- 新增骑手 -->
    <insert id="insertRider" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO rider
        (
        userId,rider_name,phone,wechat,password,status
        )
        VALUES
        (
        #{userId},#{riderName},#{phone},#{wechat},#{password},#{status}
        )
    </insert>


    <!-- 根据id查询单个骑手 -->
    <select id="selectRiderById" resultType="com.wwl.model.entity.Rider">
        SELECT * FROM rider WHERE id = #{id}
    </select>

    <!-- 根据userId查询骑手 -->
    <select id="selectRiderByUserId" resultType="com.wwl.model.entity.Rider">
        SELECT * FROM rider WHERE userId = #{userId}
    </select>

    <!-- 通用多条件组合查询：全字段覆盖，任意字段精确/模糊查询，不传自动忽略 -->
    <select id="selectRiderListByCondition" resultType="com.wwl.model.entity.Rider">
        SELECT * FROM rider
        <where>
            <if test="id != null">AND id = #{id}</if>
            <if test="userId != null and userId != ''">AND userId = #{userId}</if>
            <if test="riderName != null and riderName != ''">AND rider_name LIKE CONCAT('%',#{riderName},'%')</if>
            <if test="phone != null and phone != ''">AND phone = #{phone}</if>
            <if test="wechat != null and wechat != ''">AND wechat = #{wechat}</if>
            <if test="password != null and password != ''">AND password = #{password}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
    </select>


    <!-- 查询全部骑手 -->
    <select id="selectRiderList" resultType="com.wwl.model.entity.Rider">
        SELECT * FROM rider ORDER BY create_time DESC
    </select>


    <!-- 动态修改骑手信息 -->
    <update id="updateRider">
        UPDATE rider
        <set>
            <if test="userId != null and userId != ''">
                userId = #{userId},
            </if>
            <if test="riderName != null and riderName != ''">
                rider_name = #{riderName},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="wechat != null">
                wechat = #{wechat},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="status != null">
                status = #{status}
            </if>
        </set>
        WHERE id = #{id}
    </update>


    <!-- 删除骑手（物理删除） -->
    <delete id="deleteRiderById">
        DELETE FROM rider WHERE id = #{id}
    </delete>

</mapper>